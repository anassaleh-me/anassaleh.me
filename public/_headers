# Browser caching for the static files (Cloudflare Workers static assets).
# Fonts and vendor files have fixed names and never change, so browsers keep them for a year.
# Images are kept for a week: when replacing an image, upload it under a new file name so visitors see it at once.
# Code (CSS, JS) is checked on every visit so a new release never mixes with old files; pages preload all their
# modules, so the checks run side by side. Content (JSON) is checked on every visit too, so an edit made in
# Pages CMS shows on the very next page load.

# Security basics for every page and file.
# Content-Security-Policy: the browser only runs code from this site, the few small scripts written into the pages
# (allowed by their sha256 fingerprint: when one of those inline scripts changes, its hash here must change too),
# Cloudflare Web Analytics, and players from Vimeo and YouTube. Anything injected by an attacker is refused.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-8s3u45SmubmzQ1UX3QwHhUkWKWi7WEtiFVnDX9TYBGU=' 'sha256-9LIaHrLSDG5+/Bv64LFX6j6gn4JiQYmXtFlepF9CNHw=' 'sha256-eN6IBdILNbHpAHE5BjmWNwjcRtD1VudSb+E1chR1ML8=' 'sha256-iWt1iVGsGm/9AZlApenvg3dgX+NHtE1XUqMpVddkPB0=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://player.vimeo.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Speculation-Rules: "/speculation-rules.json"

/speculation-rules.json
  Content-Type: application/speculationrules+json

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/content/*
  Cache-Control: public, max-age=0, must-revalidate
