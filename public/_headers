# Browser caching for the static files (Cloudflare Workers static assets).
# Fonts and vendor files have fixed names and never change, so browsers keep them for a year.
# Images are kept for a week: when replacing an image, upload it under a new file name so visitors see it at once.
# Code (CSS, JS) and content (JSON) are used from the browser's copy at once and checked in the background,
# so pages never wait on a check; a change shows up on the next page or visit.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/css/*
  Cache-Control: public, max-age=60, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=60, stale-while-revalidate=604800

/content/*
  Cache-Control: public, max-age=0, stale-while-revalidate=604800
