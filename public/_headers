# Browser caching for the static files (Cloudflare Workers static assets).
# Fonts and vendor files have fixed names and never change, so browsers keep them for a year.
# Images are kept for a week: when replacing an image, upload it under a new file name so visitors see it at once.
# Code (CSS, JS) is checked on every visit so a new release never mixes with old files; pages preload all their
# modules, so the checks run side by side. Content (JSON) is used at once and refreshed in the background.

# Security basics for every page and file.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/content/*
  Cache-Control: public, max-age=0, stale-while-revalidate=604800
